# Private data — real CV content and personal facts NEVER get committed.
# The tool (code) is public-able; the data is not. See PRIVATE.md.
# The whole clients/ tree is private: profiles, variants, scraped captures, and
# even a client's *name* (a directory) must not hit git.
# No trailing slash: a symlink to an external data root ($CAREER_KIT_HOME is the
# cleaner way) is not a directory to git, and `/clients/` would not match it.
/clients

# Build artifacts (rendered CVs carry the same content as the data)
/build

# Python / uv
__pycache__/
*.pyc
.venv/

# linkedin-scrape tool: scraped output + deps are not committed
/tools/linkedin-scrape/out-*/

