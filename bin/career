#!/usr/bin/env bash
# career - the executor CLI. One precise chunk of career work per verb.
# Contract (taxonomy, JSON envelope, exit codes): docs/CONTRACT.md
#
#   career cv build|ats|match [...]           CV lane (delegates to bin/cv)
#   career cv lint [variant]                  cross-check CV vs latest LinkedIn snapshot
#   career linkedin capture <url|public-id>   snapshot a profile into the store
#   career linkedin diff [snapA snapB]        compare two snapshots (default: 2 latest)
#   career linkedin audit [snapshot]          rubric-score a snapshot (default: latest)
#   career linkedin jd <jobs-url|job-id>      snapshot a job post into the store
#   career linkedin keywords [variant]        JD keyword corpus vs the CV text
#
# Global flags (anywhere on the line): -c|--client <name>, --json
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
SCRAPER="$ROOT/tools/linkedin-scrape/li_scrape.py"
DIFFER="$ROOT/tools/linkedin-diff/li_diff.py"
AUDITOR="$ROOT/tools/linkedin-audit/li_audit.py"
JDINTEL="$ROOT/tools/jd-intel/jd_intel.py"
LINTER="$ROOT/tools/career-lint/career_lint.py"

client="" json=0
args=()
while [ $# -gt 0 ]; do
  case "$1" in
    -c|--client) client="${2:?-c needs a client name}"; shift 2 ;;
    --json) json=1; shift ;;
    *) args+=("$1"); shift ;;
  esac
done
set -- "${args[@]+"${args[@]}"}"
[ -n "$client" ] || client="$(cat "$ROOT/clients/.default" 2>/dev/null || echo denys-sychov)"

lane="${1:-}"; verb="${2:-}"

usage() { echo "usage: career {cv|linkedin} <verb> [args] [-c client] [--json]  (see docs/CONTRACT.md)" >&2; exit 2; }

# emit <ok> <data-json|null> <error-message|-> ; then exit accordingly.
emit() {
  local ok="$1" data="$2" err="$3"
  if [ "$json" = 1 ]; then
    python3 - "$ok" "$lane" "$verb" "$client" "$data" "$err" <<'PY'
import json, sys
ok, lane, verb, client, data, err = sys.argv[1:7]
print(json.dumps({
    "ok": ok == "true", "lane": lane, "verb": verb, "client": client,
    "data": None if data == "null" else json.loads(data),
    "error": None if err == "-" else {"message": err},
}))
PY
  elif [ "$err" != "-" ]; then
    echo "error: $err" >&2
  fi
  [ "$ok" = true ] || exit 1
}

fail() { emit false null "$1"; }

require_client_dir() {
  [ -d "$ROOT/clients/$client" ] || { echo "unknown client: $client" >&2; exit 2; }
}

# Newest-first snapshot dirs of one kind (a snapshot = a dir with manifest.json;
# a manifest without "kind" reads as a profile snapshot).
snapshots() {
  python3 - "$ROOT/clients/$client/captures" "${1:-profile}" <<'PY'
import json, os, sys
root, kind = sys.argv[1], sys.argv[2]
if os.path.isdir(root):
    for d in sorted(os.listdir(root), reverse=True):
        m = os.path.join(root, d, "manifest.json")
        if os.path.isfile(m):
            try:
                k = json.load(open(m)).get("kind", "profile")
            except Exception:
                continue
            if k == kind:
                print(os.path.join(root, d))
PY
}

# write_manifest <snapdir> <target> <kind>
write_manifest() {
  python3 - "$1" "$2" "$3" <<'PY'
import json, os, sys, datetime
snap, target, kind = sys.argv[1:4]
raw = os.path.join(snap, "raw")
pages = sorted(p for p in os.listdir(raw) if p.endswith(".txt")) if os.path.isdir(raw) else []
manifest = {
    "target": target,
    "captured_at": datetime.datetime.now(datetime.timezone.utc).isoformat(),
    "tool": "li-scrape",
    "kind": kind,
    "pages": pages,
    "legacy": False,
}
with open(os.path.join(snap, "manifest.json"), "w") as f:
    json.dump(manifest, f, indent=2)
PY
}

# scrape_to_store <target> <kind> ; sets $snap
scrape_to_store() {
  local target="$1" kind="$2"
  curl -sf --max-time 3 http://localhost:9777/json/version >/dev/null 2>&1 \
    || fail "no CDP Chrome on :9777 - launch your logged-in Chrome first (see tools/linkedin-scrape/README.md)"
  snap="$ROOT/clients/$client/captures/$(date -u +%Y-%m-%dT%H-%M-%SZ)"
  mkdir -p "$snap"
  if ! uv run "$SCRAPER" "$target" "$snap" >&2; then
    rm -rf "$snap"
    fail "scrape failed for $target"
  fi
  write_manifest "$snap" "$target" "$kind"
}

case "$lane" in
  cv)
    if [ "$verb" = lint ]; then
      require_client_dir
      variant="${3:-baseline}"
      snap="$(snapshots profile | head -1)"
      [ -n "$snap" ] || fail "no profile snapshots for $client - run: career linkedin capture"
      vargs=()
      vfile="$ROOT/clients/$client/variants/$variant.yml"
      [ -f "$vfile" ] && vargs=(--variant "$vfile")
      if [ "$json" = 1 ]; then
        data="$(python3 "$LINTER" "$ROOT/clients/$client/profile.yml" "$snap" ${vargs[0]:+"${vargs[@]}"} --json)" \
          || [ $? -eq 1 ] || fail "lint failed to run"
        emit true "$data" -
      else
        exec python3 "$LINTER" "$ROOT/clients/$client/profile.yml" "$snap" ${vargs[0]:+"${vargs[@]}"}
      fi
    fi
    case "$verb" in
      build|ats|match) ;;
      *) usage ;;
    esac
    shift 2 || true
    if [ "$json" = 1 ] && [ "$verb" = build ]; then
      out="$("$ROOT/bin/cv" "$verb" "$@" -c "$client")" || fail "cv build failed"
      pdf="${out#→ }"
      emit true "$(python3 -c 'import json,sys; print(json.dumps({"pdf": sys.argv[1]}))' "$pdf")" -
    else
      exec "$ROOT/bin/cv" "$verb" "$@" -c "$client"   # text verbs pass through
    fi
    ;;

  linkedin)
    require_client_dir
    case "$verb" in
      capture)
        target="${3:?usage: career linkedin capture <profile-url-or-public-id>}"
        case "$target" in */jobs/*) fail "that is a job post - use: career linkedin jd" ;; esac
        scrape_to_store "$target" profile
        if [ "$json" = 1 ]; then
          emit true "$(python3 -c 'import json,sys; print(json.dumps({"snapshot": sys.argv[1]}))' "$snap")" -
        else
          echo "→ $snap"
        fi
        ;;

      jd)
        target="${3:?usage: career linkedin jd <jobs-view-url-or-job-id>}"
        case "$target" in
          */jobs/*) ;;
          *) [[ "$target" =~ ^[0-9]{6,}$ ]] || fail "not a job post URL or id: $target" ;;
        esac
        scrape_to_store "$target" job
        if [ "$json" = 1 ]; then
          emit true "$(python3 -c 'import json,sys; print(json.dumps({"snapshot": sys.argv[1]}))' "$snap")" -
        else
          echo "→ $snap"
        fi
        ;;

      keywords)
        variant="${3:-baseline}"
        mapfile -t jobsnaps < <(snapshots job)
        [ "${#jobsnaps[@]}" -ge 1 ] || fail "no job snapshots for $client - run: career linkedin jd <jobs-url>"
        cvargs=()
        md="$(ls "$ROOT/build/$client/$variant"/*_CV.md 2>/dev/null | head -1)"
        [ -n "$md" ] && cvargs=(--cv "$md")
        if [ "$json" = 1 ]; then
          data="$(python3 "$JDINTEL" "${jobsnaps[@]}" ${cvargs[0]:+"${cvargs[@]}"} --json)" || fail "keyword aggregation failed"
          emit true "$data" -
        else
          exec python3 "$JDINTEL" "${jobsnaps[@]}" ${cvargs[0]:+"${cvargs[@]}"}
        fi
        ;;

      diff)
        a="${3:-}"; b="${4:-}"
        if [ -z "$a" ]; then
          mapfile -t latest < <(snapshots | head -2)
          [ "${#latest[@]}" -ge 2 ] || fail "need two snapshots for $client (found ${#latest[@]}) - run: career linkedin capture"
          a="${latest[1]}"; b="${latest[0]}"   # older -> newer
        fi
        [ -d "$a" ] && [ -d "$b" ] || fail "snapshot dir not found: $a / $b"
        if [ "$json" = 1 ]; then
          data="$(python3 "$DIFFER" "$a" "$b" --json)" || fail "diff failed"
          emit true "$data" -
        else
          exec python3 "$DIFFER" "$a" "$b"
        fi
        ;;

      audit)
        snap="${3:-}"
        if [ -z "$snap" ]; then
          snap="$(snapshots | head -1)"
          [ -n "$snap" ] || fail "no snapshots for $client - run: career linkedin capture"
        fi
        [ -d "$snap" ] || fail "snapshot dir not found: $snap"
        if [ "$json" = 1 ]; then
          data="$(python3 "$AUDITOR" "$snap" --json)" || fail "audit failed"
          emit true "$data" -
        else
          exec python3 "$AUDITOR" "$snap"
        fi
        ;;

      *) usage ;;
    esac
    ;;

  *) usage ;;
esac
