#!/usr/bin/env bash
# career-kit driver: generate RenderCV input -> render -> ATS-check a variant.
#
#   cv build [variant]        merge YAML (uv) and render PDF (RenderCV, sb2nov)
#   cv ats   [variant]        print the text an ATS parser sees (RenderCV .md)
#   cv match [variant] <jd>   report which words in <jd> the CV text is missing
#
# variant defaults to "baseline". Requires uv (uvx) + internet on first run
# (RenderCV self-fetches via uvx).
set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
BUILD="$ROOT/build"
RENDERCV=(uvx --from "rendercv[full]" rendercv)

cmd="${1:-build}"
variant="${2:-baseline}"
out="$BUILD/$variant"                    # per-variant output folder

md_path() { ls "$out"/*_CV.md 2>/dev/null | head -1; }

case "$cmd" in
  build)
    uv run "$ROOT/generate.py" "$variant" >/dev/null
    "${RENDERCV[@]}" render "$BUILD/$variant.rendercv.yaml" \
        --output-folder "$out" >/dev/null
    echo "→ $(ls "$out"/*_CV.pdf 2>/dev/null | head -1)"
    ;;
  ats)
    md="$(md_path)"; [ -n "$md" ] || { echo "build $variant first" >&2; exit 1; }
    cat "$md"
    ;;
  match)
    jd="${3:?usage: cv match <variant> <jd-file>}"
    md="$(md_path)"; [ -n "$md" ] || { echo "build $variant first" >&2; exit 1; }
    txt="$(tr '[:upper:]' '[:lower:]' < "$md")"
    echo "Keywords in JD not found in CV text:"
    tr '[:upper:]' '[:lower:]' < "$jd" \
      | grep -oE '[a-z][a-z0-9.+/#-]{2,}' | sort -u \
      | while read -r w; do grep -qF "$w" <<<"$txt" || echo "  - $w"; done
    ;;
  *)
    echo "usage: cv {build|ats|match} [variant] [jd-file]" >&2
    exit 1
    ;;
esac
